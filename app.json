{
  "expo": {
    "name": "Голосовая CRM риелтора",
    "slug": "voice-crm-rieltor",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.voicecrm.realtor",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Приложению нужен доступ к микрофону для голосовых заметок",
        "NSPhotoLibraryUsageDescription": "Приложению нужен доступ к фото для объектов"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "ru.voicecrm.realtor",
      "permissions": [
        "MODIFY_AUDIO_SETTINGS",
        "POST_NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "RECORD_AUDIO",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "VIBRATE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-notifications",
      [
        "react-native-vosk",
        {
          "models": [
            "assets/vosk-model-small-ru-0.22"
          ],
          "iOSMicrophonePermission": "Приложению нужен доступ к микрофону для голосовых заметок риелтора"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "owner": "zarias87",
    "extra": {
      "eas": {
        "projectId": "0b250f0c-cbb6-4e26-93a1-7ff4ffdf92fe"
      }
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/0b250f0c-cbb6-4e26-93a1-7ff4ffdf92fe"
    },
    "runtimeVersion": "1.0.0"
  }
}