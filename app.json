{
  "expo": {
    "name": "Голосовая CRM риелтора",
    "slug": "voice-crm-realtor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.voicecrm.realtor",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Приложению нужен доступ к микрофону для голосовых заметок",
        "NSPhotoLibraryUsageDescription": "Приложению нужен доступ к фото для объектов"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "ru.voicecrm.realtor",
      "permissions": [
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "USE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-status-bar",
      "expo-sharing"
    ],
    "owner": "vitaliyskorickiy"
  }
}
